<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(HarpoRoot)/HarpoS7.Family0/**/*.cs" Exclude="**/obj/**;**/bin/**" />
    <Compile Include="$(HarpoRoot)/HarpoS7.Utilities/**/*.cs" Exclude="**/obj/**;**/bin/**" />
    <Reference Include="CommunityToolkit.HighPerformance">
      <HintPath>$(ToolkitAssembly)</HintPath>
    </Reference>
    <EmbeddedResource Include="$(HarpoRoot)/HarpoS7.Family0/Data/Blobs/Transform12Metadata.bin">
      <LogicalName>HarpoS7.Family0.Data.Blobs.Transform12Metadata.bin</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
